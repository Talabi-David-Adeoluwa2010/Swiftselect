// Open or create the IndexedDB database
function openDatabase() {
  return new Promise((resolve, reject) => {
    const request = indexedDB.open("ProductCacheDB", 1);
    
    request.onupgradeneeded = (event) => {
      const db = event.target.result;
      if (!db.objectStoreNames.contains("products")) {
        db.createObjectStore("products", { keyPath: "id" });
      }
    };
    
    request.onsuccess = (event) => resolve(event.target.result);
    request.onerror = (event) => reject(event.target.error);
  });
}

// Save products to IndexedDB
async function saveProductsToCache(productsArray) {
  const db = await openDatabase();
  const transaction = db.transaction("products", "readwrite");
  const store = transaction.objectStore("products");
  
  // Clear old cache and add fresh items
  store.clear();
  productsArray.forEach(product => store.put(product));
  
  return transaction.complete;
}

// Load products instantly from IndexedDB
async function getProductsFromCache() {
  const db = await openDatabase();
  return new Promise((resolve, reject) => {
    const transaction = db.transaction("products", "readonly");
    const store = transaction.objectStore("products");
    const request = store.getAll();
    
    request.onsuccess = () => resolve(request.result);
    request.onerror = () => reject(request.error);
  });
}
